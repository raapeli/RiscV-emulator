# CONFIG_SMP is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_PCI is not set
# CONFIG_USB is not set

# Boot through OpenSBI on the emulator's device-tree platform.
CONFIG_NONPORTABLE=y
CONFIG_MMU=y
CONFIG_ARCH_VIRT=y
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_EFI is not set
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set

# The guest uses the serial console and a virtio block disk.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
# CONFIG_BTRFS_FS is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_MTD is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_VT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_BALLOON is not set

# Keep the existing crypto RNG providers and skip boot-time debug self-tests.
CONFIG_CRYPTO_DRBG_MENU=y
CONFIG_CRYPTO_JITTERENTROPY=y
# CONFIG_DEBUG_PLIST is not set
# CONFIG_DEBUG_VM_PGTABLE is not set
